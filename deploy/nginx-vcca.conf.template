# /etc/nginx/sites-available/vcca — generated by deploy/install.sh from deploy/nginx-vcca.conf.template
# (@DOMAIN@ is replaced with the --domain value). Written ONCE: re-running install.sh never overwrites it,
# because `certbot --nginx` edits this file afterwards (adds `listen 443 ssl`, the certificate lines and a
# separate port-80 -> HTTPS redirect server). To regenerate: delete it and re-run install.sh.
server {
    listen 80;
    listen [::]:80;
    server_name @DOMAIN@;

    # ACME http-01 challenges (certbot --nginx serves these itself; kept for webroot renewals)
    location /.well-known/acme-challenge/ { root /var/www/html; }

    client_max_body_size 600m;          # VAMSYS workspaces.db upload (app limit: fixed 512 MB)
    client_body_timeout 300s;
    add_header Strict-Transport-Security "max-age=31536000" always;   # only honoured by browsers over HTTPS

    location / {
        proxy_pass http://127.0.0.1:8770;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;       # login rate limiting (VCCA_TRUST_PROXY=1)
        proxy_set_header X-Forwarded-Proto $scheme;          # https -> session cookie gets "Secure"
        proxy_read_timeout 300s;                             # report payload / zip of a run folder
        proxy_send_timeout 300s;
        proxy_request_buffering off;                         # stream uploads straight to the app
    }
}
